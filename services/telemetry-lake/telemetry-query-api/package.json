{
  "name": "@telemetry-lake/telemetry-query-api",
  "version": "0.1.0",
  "private": true,
  "description": "Read-optimized query API over ClickHouse: percentile latency, error-rate rollups, trace correlation, statistical baseline deviation, and A/B canary differential benchmarking.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.6.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.10",
    "@types/express": "^4.17.21"
  }
}
