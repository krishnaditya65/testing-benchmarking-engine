<!--
  storage-policy.local-dev.xml — local-dev variant of storage-policy.xml.

  Same policy/disk/volume names as storage-policy.xml (must stay identical to what migration
  005 references: policy `hot_to_cold_tiered`, volumes `hot`/`cold`), but the cold disk is a
  second bind-mounted local directory (`<type>local</type>`) instead of S3, so `docker-compose
  up` gives a real, working two-tier policy without needing cloud credentials or network
  access. This is deliberately smaller-scale than production (a second local disk is much
  cheaper/faster than S3, so it doesn't reproduce prod's latency/cost tradeoff) — it exists so
  migration 005 has something to actually attach to locally instead of failing, and so the
  tiering mechanism itself (TTL ... TO VOLUME) is exercised in local dev, not just prod/staging.

  Mounted by docker-compose.yml's telemetry-metrics-clickhouse service into
  /etc/clickhouse-server/config.d/storage-policy.local-dev.xml. The path
  `/var/lib/clickhouse/cold-tier` below is the in-container mount point for the
  `.docker-volumes/clickhouse-cold-tier` bind mount declared in docker-compose.yml.
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <cold_tier_local>
                <type>local</type>
                <path>/var/lib/clickhouse/cold-tier/</path>
            </cold_tier_local>
        </disks>
        <policies>
            <hot_to_cold_tiered>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>cold_tier_local</disk>
                        <perform_ttl_move_on_insert>0</perform_ttl_move_on_insert>
                    </cold>
                </volumes>
                <move_factor>0.1</move_factor>
            </hot_to_cold_tiered>
        </policies>
    </storage_configuration>
</clickhouse>
