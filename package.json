{
  "name": "distributed-testing-benchmarking-tool",
  "private": true,
  "description": "Enterprise distributed testing, benchmarking, load, and chaos platform.",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "services/orchestration-control-plane/workflow-canvas-frontend",
    "services/orchestration-control-plane/pipeline-api-gateway",
    "services/orchestration-control-plane/test-data-factory-service",
    "services/orchestration-control-plane/environment-lifecycle-manager",
    "services/orchestration-control-plane/run-cost-estimator",
    "services/telemetry-lake/telemetry-query-api",
    "services/telemetry-lake/redpanda-ingestion-pipeline",
    "services/ai-assisted-qa/contract-healing-service",
    "services/ai-assisted-qa/log-to-test-generator-service",
    "services/ai-assisted-qa/canary-rollout-authorizer",
    "services/distributed-systems-validation/service-mesh-policy-verifier",
    "services/shared-libraries/dag-domain-model",
    "services/shared-libraries/observability-kit",
    "tools/testforge-cli"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:control-plane": "pnpm --filter pipeline-api-gateway dev",
    "dev:frontend": "pnpm --filter workflow-canvas-frontend dev"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
